# Supabase — copy to `.env.local` and fill in from your project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public origin used as a fallback for email confirmation/reset links.
# The app derives the origin from the incoming request first.
NEXT_PUBLIC_SITE_URL=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
